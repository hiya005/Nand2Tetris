// Hack CPU (Central Processing Unit)
// Instruction format: i xx a cccccc ddd jjj
//   bit 15 = i (0 = A-instruction, 1 = C-instruction)
//   bit 12 = a (selects A or M as ALU y input)
//   bits 11..6 = zx nx zy ny f no (ALU control)
//   bits 5,4,3 = d1 d2 d3 (dest: A, D, M)
//   bits 2,1,0 = j1 j2 j3 (jump: <0, =0, >0)

CHIP CPU {

    IN  inM[16],         // M value input  (M = contents of RAM[A])
        instruction[16], // Instruction for execution
        reset;           // Signals whether to re-start the current program

    OUT outM[16],        // M value output
        writeM,          // Write to M?
        addressM[15],    // Address in data memory (of M)
        pc[15];          // Address of next instruction

    PARTS:
    // ---------- Instruction type ----------
    Not(in=instruction[15], out=isA);        // 1 if A-instruction

    // ---------- A register ----------
    // A-instruction: load the instruction itself; C-instruction: load ALU output
    Mux16(a=instruction, b=aluOut, sel=instruction[15], out=aIn);
    // Load A if A-instruction OR (C-instruction with d1 = 1)
    Or(a=isA, b=instruction[5], out=loadA);
    ARegister(in=aIn, load=loadA, out=aOut, out[0..14]=addressM);

    // ---------- ALU y input: A or M ----------
    Mux16(a=aOut, b=inM, sel=instruction[12], out=yIn);

    // ---------- D register ----------
    And(a=instruction[15], b=instruction[4], out=loadD);
    DRegister(in=aluOut, load=loadD, out=dOut);

    // ---------- ALU ----------
    ALU(x=dOut, y=yIn,
        zx=instruction[11], nx=instruction[10],
        zy=instruction[9],  ny=instruction[8],
        f=instruction[7],   no=instruction[6],
        out=aluOut, out=outM, zr=zr, ng=ng);

    // ---------- writeM ----------
    And(a=instruction[15], b=instruction[3], out=writeM);

    // ---------- Jump logic ----------
    Or(a=zr, b=ng, out=zrOrNg);
    Not(in=zrOrNg, out=pos);                 // out > 0

    And(a=instruction[2], b=ng,  out=jLT);   // j1 and out < 0
    And(a=instruction[1], b=zr,  out=jEQ);   // j2 and out = 0
    And(a=instruction[0], b=pos, out=jGT);   // j3 and out > 0
    Or(a=jLT, b=jEQ, out=jLE);
    Or(a=jLE, b=jGT, out=jumpCond);

    // Only jump on C-instructions
    And(a=instruction[15], b=jumpCond, out=loadPC);

    // ---------- Program Counter ----------
    PC(in=aOut, load=loadPC, inc=true, reset=reset, out[0..14]=pc);
}

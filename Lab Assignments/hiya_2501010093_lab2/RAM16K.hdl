
CHIP RAM16K {
    IN in[16], load, address[14];
    OUT out[16];

    PARTS:
    DMux(in=load, sel=address[13],
        a=load0, b=load1);

    RAM8K(in=in, load=load0,
        address=address[0..12], out=r0);

    RAM8K(in=in, load=load1,
        address=address[0..12], out=r1);

    Mux16(a=r0, b=r1,
        sel=address[13], out=out);
}

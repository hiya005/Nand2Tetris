CHIP ALU {
    IN x[16], y[16], zx, nx, zy, ny, f, no;
    OUT out[16], zr, ng;

    PARTS:

    // STEP 1: Process x
    Mux(a=x[0], b=false, sel=zx, out=xz0);
    Not(in=xz0, out=xn0);
    Mux(a=xz0, b=xn0, sel=nx, out=xp0);
    Mux(a=x[1], b=false, sel=zx, out=xz1);
    Not(in=xz1, out=xn1);
    Mux(a=xz1, b=xn1, sel=nx, out=xp1);
    Mux(a=x[2], b=false, sel=zx, out=xz2);
    Not(in=xz2, out=xn2);
    Mux(a=xz2, b=xn2, sel=nx, out=xp2);
    Mux(a=x[3], b=false, sel=zx, out=xz3);
    Not(in=xz3, out=xn3);
    Mux(a=xz3, b=xn3, sel=nx, out=xp3);
    Mux(a=x[4], b=false, sel=zx, out=xz4);
    Not(in=xz4, out=xn4);
    Mux(a=xz4, b=xn4, sel=nx, out=xp4);
    Mux(a=x[5], b=false, sel=zx, out=xz5);
    Not(in=xz5, out=xn5);
    Mux(a=xz5, b=xn5, sel=nx, out=xp5);
    Mux(a=x[6], b=false, sel=zx, out=xz6);
    Not(in=xz6, out=xn6);
    Mux(a=xz6, b=xn6, sel=nx, out=xp6);
    Mux(a=x[7], b=false, sel=zx, out=xz7);
    Not(in=xz7, out=xn7);
    Mux(a=xz7, b=xn7, sel=nx, out=xp7);
    Mux(a=x[8], b=false, sel=zx, out=xz8);
    Not(in=xz8, out=xn8);
    Mux(a=xz8, b=xn8, sel=nx, out=xp8);
    Mux(a=x[9], b=false, sel=zx, out=xz9);
    Not(in=xz9, out=xn9);
    Mux(a=xz9, b=xn9, sel=nx, out=xp9);
    Mux(a=x[10], b=false, sel=zx, out=xz10);
    Not(in=xz10, out=xn10);
    Mux(a=xz10, b=xn10, sel=nx, out=xp10);
    Mux(a=x[11], b=false, sel=zx, out=xz11);
    Not(in=xz11, out=xn11);
    Mux(a=xz11, b=xn11, sel=nx, out=xp11);
    Mux(a=x[12], b=false, sel=zx, out=xz12);
    Not(in=xz12, out=xn12);
    Mux(a=xz12, b=xn12, sel=nx, out=xp12);
    Mux(a=x[13], b=false, sel=zx, out=xz13);
    Not(in=xz13, out=xn13);
    Mux(a=xz13, b=xn13, sel=nx, out=xp13);
    Mux(a=x[14], b=false, sel=zx, out=xz14);
    Not(in=xz14, out=xn14);
    Mux(a=xz14, b=xn14, sel=nx, out=xp14);
    Mux(a=x[15], b=false, sel=zx, out=xz15);
    Not(in=xz15, out=xn15);
    Mux(a=xz15, b=xn15, sel=nx, out=xp15);

    // STEP 2: Process y
    Mux(a=y[0], b=false, sel=zy, out=yz0);
    Not(in=yz0, out=yn0);
    Mux(a=yz0, b=yn0, sel=ny, out=yp0);
    Mux(a=y[1], b=false, sel=zy, out=yz1);
    Not(in=yz1, out=yn1);
    Mux(a=yz1, b=yn1, sel=ny, out=yp1);
    Mux(a=y[2], b=false, sel=zy, out=yz2);
    Not(in=yz2, out=yn2);
    Mux(a=yz2, b=yn2, sel=ny, out=yp2);
    Mux(a=y[3], b=false, sel=zy, out=yz3);
    Not(in=yz3, out=yn3);
    Mux(a=yz3, b=yn3, sel=ny, out=yp3);
    Mux(a=y[4], b=false, sel=zy, out=yz4);
    Not(in=yz4, out=yn4);
    Mux(a=yz4, b=yn4, sel=ny, out=yp4);
    Mux(a=y[5], b=false, sel=zy, out=yz5);
    Not(in=yz5, out=yn5);
    Mux(a=yz5, b=yn5, sel=ny, out=yp5);
    Mux(a=y[6], b=false, sel=zy, out=yz6);
    Not(in=yz6, out=yn6);
    Mux(a=yz6, b=yn6, sel=ny, out=yp6);
    Mux(a=y[7], b=false, sel=zy, out=yz7);
    Not(in=yz7, out=yn7);
    Mux(a=yz7, b=yn7, sel=ny, out=yp7);
    Mux(a=y[8], b=false, sel=zy, out=yz8);
    Not(in=yz8, out=yn8);
    Mux(a=yz8, b=yn8, sel=ny, out=yp8);
    Mux(a=y[9], b=false, sel=zy, out=yz9);
    Not(in=yz9, out=yn9);
    Mux(a=yz9, b=yn9, sel=ny, out=yp9);
    Mux(a=y[10], b=false, sel=zy, out=yz10);
    Not(in=yz10, out=yn10);
    Mux(a=yz10, b=yn10, sel=ny, out=yp10);
    Mux(a=y[11], b=false, sel=zy, out=yz11);
    Not(in=yz11, out=yn11);
    Mux(a=yz11, b=yn11, sel=ny, out=yp11);
    Mux(a=y[12], b=false, sel=zy, out=yz12);
    Not(in=yz12, out=yn12);
    Mux(a=yz12, b=yn12, sel=ny, out=yp12);
    Mux(a=y[13], b=false, sel=zy, out=yz13);
    Not(in=yz13, out=yn13);
    Mux(a=yz13, b=yn13, sel=ny, out=yp13);
    Mux(a=y[14], b=false, sel=zy, out=yz14);
    Not(in=yz14, out=yn14);
    Mux(a=yz14, b=yn14, sel=ny, out=yp14);
    Mux(a=y[15], b=false, sel=zy, out=yz15);
    Not(in=yz15, out=yn15);
    Mux(a=yz15, b=yn15, sel=ny, out=yp15);

    // STEP 3: Bitwise AND
    And(a=xp0, b=yp0, out=and0);
    And(a=xp1, b=yp1, out=and1);
    And(a=xp2, b=yp2, out=and2);
    And(a=xp3, b=yp3, out=and3);
    And(a=xp4, b=yp4, out=and4);
    And(a=xp5, b=yp5, out=and5);
    And(a=xp6, b=yp6, out=and6);
    And(a=xp7, b=yp7, out=and7);
    And(a=xp8, b=yp8, out=and8);
    And(a=xp9, b=yp9, out=and9);
    And(a=xp10, b=yp10, out=and10);
    And(a=xp11, b=yp11, out=and11);
    And(a=xp12, b=yp12, out=and12);
    And(a=xp13, b=yp13, out=and13);
    And(a=xp14, b=yp14, out=and14);
    And(a=xp15, b=yp15, out=and15);

    // STEP 4: Addition
    HalfAdder(a=xp0, b=yp0, sum=add0, carry=carry1);
    FullAdder(a=xp1, b=yp1, c=carry1, sum=add1, carry=carry2);
    FullAdder(a=xp2, b=yp2, c=carry2, sum=add2, carry=carry3);
    FullAdder(a=xp3, b=yp3, c=carry3, sum=add3, carry=carry4);
    FullAdder(a=xp4, b=yp4, c=carry4, sum=add4, carry=carry5);
    FullAdder(a=xp5, b=yp5, c=carry5, sum=add5, carry=carry6);
    FullAdder(a=xp6, b=yp6, c=carry6, sum=add6, carry=carry7);
    FullAdder(a=xp7, b=yp7, c=carry7, sum=add7, carry=carry8);
    FullAdder(a=xp8, b=yp8, c=carry8, sum=add8, carry=carry9);
    FullAdder(a=xp9, b=yp9, c=carry9, sum=add9, carry=carry10);
    FullAdder(a=xp10, b=yp10, c=carry10, sum=add10, carry=carry11);
    FullAdder(a=xp11, b=yp11, c=carry11, sum=add11, carry=carry12);
    FullAdder(a=xp12, b=yp12, c=carry12, sum=add12, carry=carry13);
    FullAdder(a=xp13, b=yp13, c=carry13, sum=add13, carry=carry14);
    FullAdder(a=xp14, b=yp14, c=carry14, sum=add14, carry=carry15);
    FullAdder(a=xp15, b=yp15, c=carry15, sum=add15, carry=carry16);

    // STEP 5: Select AND or addition, then optional negation
    Mux(a=and0, b=add0, sel=f, out=func0);
    Not(in=func0, out=notfunc0);
    Mux(a=func0, b=notfunc0, sel=no, out=r0);
    And(a=r0, b=true, out=out[0]);

    Mux(a=and1, b=add1, sel=f, out=func1);
    Not(in=func1, out=notfunc1);
    Mux(a=func1, b=notfunc1, sel=no, out=r1);
    And(a=r1, b=true, out=out[1]);

    Mux(a=and2, b=add2, sel=f, out=func2);
    Not(in=func2, out=notfunc2);
    Mux(a=func2, b=notfunc2, sel=no, out=r2);
    And(a=r2, b=true, out=out[2]);

    Mux(a=and3, b=add3, sel=f, out=func3);
    Not(in=func3, out=notfunc3);
    Mux(a=func3, b=notfunc3, sel=no, out=r3);
    And(a=r3, b=true, out=out[3]);

    Mux(a=and4, b=add4, sel=f, out=func4);
    Not(in=func4, out=notfunc4);
    Mux(a=func4, b=notfunc4, sel=no, out=r4);
    And(a=r4, b=true, out=out[4]);

    Mux(a=and5, b=add5, sel=f, out=func5);
    Not(in=func5, out=notfunc5);
    Mux(a=func5, b=notfunc5, sel=no, out=r5);
    And(a=r5, b=true, out=out[5]);

    Mux(a=and6, b=add6, sel=f, out=func6);
    Not(in=func6, out=notfunc6);
    Mux(a=func6, b=notfunc6, sel=no, out=r6);
    And(a=r6, b=true, out=out[6]);

    Mux(a=and7, b=add7, sel=f, out=func7);
    Not(in=func7, out=notfunc7);
    Mux(a=func7, b=notfunc7, sel=no, out=r7);
    And(a=r7, b=true, out=out[7]);

    Mux(a=and8, b=add8, sel=f, out=func8);
    Not(in=func8, out=notfunc8);
    Mux(a=func8, b=notfunc8, sel=no, out=r8);
    And(a=r8, b=true, out=out[8]);

    Mux(a=and9, b=add9, sel=f, out=func9);
    Not(in=func9, out=notfunc9);
    Mux(a=func9, b=notfunc9, sel=no, out=r9);
    And(a=r9, b=true, out=out[9]);

    Mux(a=and10, b=add10, sel=f, out=func10);
    Not(in=func10, out=notfunc10);
    Mux(a=func10, b=notfunc10, sel=no, out=r10);
    And(a=r10, b=true, out=out[10]);

    Mux(a=and11, b=add11, sel=f, out=func11);
    Not(in=func11, out=notfunc11);
    Mux(a=func11, b=notfunc11, sel=no, out=r11);
    And(a=r11, b=true, out=out[11]);

    Mux(a=and12, b=add12, sel=f, out=func12);
    Not(in=func12, out=notfunc12);
    Mux(a=func12, b=notfunc12, sel=no, out=r12);
    And(a=r12, b=true, out=out[12]);

    Mux(a=and13, b=add13, sel=f, out=func13);
    Not(in=func13, out=notfunc13);
    Mux(a=func13, b=notfunc13, sel=no, out=r13);
    And(a=r13, b=true, out=out[13]);

    Mux(a=and14, b=add14, sel=f, out=func14);
    Not(in=func14, out=notfunc14);
    Mux(a=func14, b=notfunc14, sel=no, out=r14);
    And(a=r14, b=true, out=out[14]);

    Mux(a=and15, b=add15, sel=f, out=func15);
    Not(in=func15, out=notfunc15);
    Mux(a=func15, b=notfunc15, sel=no, out=r15);
    And(a=r15, b=true, out=out[15]);

    // STEP 6: Calculate zero flag using internal result bits
    Or(a=r0, b=r1, out=zr0);
    Or(a=r2, b=r3, out=zr1);
    Or(a=r4, b=r5, out=zr2);
    Or(a=r6, b=r7, out=zr3);
    Or(a=r8, b=r9, out=zr4);
    Or(a=r10, b=r11, out=zr5);
    Or(a=r12, b=r13, out=zr6);
    Or(a=r14, b=r15, out=zr7);

    Or(a=zr0, b=zr1, out=zr8);
    Or(a=zr2, b=zr3, out=zr9);
    Or(a=zr4, b=zr5, out=zr10);
    Or(a=zr6, b=zr7, out=zr11);

    Or(a=zr8, b=zr9, out=zr12);
    Or(a=zr10, b=zr11, out=zr13);
    Or(a=zr12, b=zr13, out=zr14);
    Not(in=zr14, out=zr);

    // STEP 7: Negative flag
    And(a=r15, b=true, out=ng);
}

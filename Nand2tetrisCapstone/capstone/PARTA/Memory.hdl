CHIP Memory {
    IN in[16], load, address[15];
    OUT out[16];

    PARTS:
    DMux(in=load, sel=address[14], a=loadRAM, b=loadScreenKeyboard);

    DMux(in=loadScreenKeyboard, sel=address[13], a=loadScreen, b=loadKeyboard);

    RAM16K(
        in=in, load=loadRAM,
        address=address[0..13], out=ramOut
    );

    Screen(
        in=in, load=loadScreen,
        address=address[0..12], out=screenOut
    );

    Keyboard(out=keyboardOut);

    Mux16(a=ramOut, b=screenOut, sel=address[14], out=screenOrKeyboard);
    Mux16(a=screenOrKeyboard, b=keyboardOut, sel=address[13], out=out);
}
